Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2

Visualization Manager:
  Displays:

    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic: /robot_description
      Links:
        All Links Enabled: true   # ← wheels visible here

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: false

    - Class: rviz_default_plugins/LaserScan
      Name: Front LaserScan
      Enabled: true
      Topic: /front_2d_lidar/scan

    - Class: rviz_default_plugins/LaserScan
      Name: Rear LaserScan
      Enabled: true
      Topic: /back_2d_lidar/scan

    - Class: rviz_default_plugins/PointCloud2
      Name: 3D Lidar
      Enabled: true
      Topic: /front_3d_lidar/lidar_points

    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic: /map

    - Class: rviz_default_plugins/PoseArray
      Name: Amcl Particle Swarm
      Enabled: true
      Topic: /particlecloud

    - Class: rviz_common/Group
      Name: Global Planner
      Enabled: true
      Displays:

        - Class: rviz_default_plugins/Map
          Name: Global Costmap
          Enabled: true
          Topic: /global_costmap/costmap

        - Class: rviz_default_plugins/Map
          Name: Downsampled Costmap
          Enabled: true
          Topic: /downsampled_costmap

        - Class: rviz_default_plugins/Path
          Name: Path
          Enabled: true
          Topic: /plan

        - Class: rviz_default_plugins/PointCloud
          Name: VoxelGrid
          Enabled: true
          Topic: /global_costmap/voxel_marked_cloud

    - Class: rviz_common/Group
      Name: Controller
      Enabled: true
      Displays:

        - Class: rviz_default_plugins/Map
          Name: Local Costmap
          Enabled: true
          Topic: /local_costmap/costmap

        - Class: rviz_default_plugins/Path
          Name: Local Plan
          Enabled: true
          Topic: /local_plan

        - Class: rviz_default_plugins/Polygon
          Name: Footprint
          Enabled: true
          Topic: /local_costmap/published_footprint

        - Class: rviz_default_plugins/PointCloud
          Name: Local VoxelGrid
          Enabled: true
          Topic: /local_costmap/voxel_marked_cloud

    - Class: rviz_default_plugins/MarkerArray
      Name: Waypoints
      Enabled: true
      Topic: /waypoints

    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic: /rgb

  Global Options:
    Fixed Frame: odom
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: rviz_default_plugins/PublishPoint
      Topic: /clicked_point
    - Class: nav2_rviz_plugins/GoalTool

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: odom
